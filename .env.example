# ─────────────────────────────────────────────────────────────
# Wybór dostawcy danych
# ─────────────────────────────────────────────────────────────
# zapier     — przez Twój serwer Zapier MCP. Działa OD RAZU, bo Zapier ma
#              własny, zatwierdzony przez Google developer token. (domyślne)
# google-ads — bezpośrednio do Google Ads API. Wymaga własnego developer
#              tokena zatwierdzonego przez Google.
ADS_PROVIDER=zapier

# ─────────────────────────────────────────────────────────────
# Dostawca: zapier
# ─────────────────────────────────────────────────────────────
# Adres serwera MCP z ustawień Zapier MCP. ZAWIERA KLUCZ DOSTĘPU —
# traktuj jak hasło, nigdy nie commituj.
ZAPIER_MCP_URL=

# ─────────────────────────────────────────────────────────────
# Dostawca: google-ads
# ─────────────────────────────────────────────────────────────
# Developer token z konta menedżerskiego Google Ads.
# API Center → wniosek → ręczna akceptacja Google (zwykle kilka dni).
GOOGLE_ADS_DEVELOPER_TOKEN=

# Dane klienta OAuth 2.0 (Google Cloud Console → Credentials → OAuth client ID,
# typ "Desktop app" albo "Web application").
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token wygenerowany dla zakresu
# https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=

# Customer ID konta MENEDŻERSKIEGO — ustaw TYLKO jeśli konto docelowe leży
# pod managerem. Przy koncie z dostępem bezpośrednim zbędna wartość powoduje
# "User doesn't have permission to access customer" (sprawdzone na MODOhome).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
